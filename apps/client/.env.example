# Supabase Configuration
# Copy this file to .env and fill in your values from:
# Supabase Dashboard -> Project Settings -> API

EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key_here

# Optional: For full seed (pnpm seed) - bypasses RLS. Never commit or expose.
# Get from Dashboard -> Project Settings -> API -> service_role
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
