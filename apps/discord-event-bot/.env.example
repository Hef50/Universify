# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here

# Optional: Customize timezone (default: America/New_York)
TIMEZONE=America/New_York

# Optional: Customize review category name (default: Event Review)
REVIEW_CATEGORY_NAME=Event Review

# Supabase — approved events are inserted into the same `events` table as the mobile app.
# Use Project Settings → API: Project URL and service_role key (keep secret; never ship to clients).
# SUPABASE_ORGANIZER_ID must be a real auth.users id (UUID), e.g. a dedicated "Discord bot" user in Supabase Auth.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ORGANIZER_ID=