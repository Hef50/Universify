# Slack credentials — create an app at https://api.slack.com/apps
# Bot token (OAuth & Permissions -> Bot User OAuth Token)
SLACK_BOT_TOKEN=xoxb-your-bot-token
# Signing secret (Basic Information -> App Credentials)
SLACK_SIGNING_SECRET=your_signing_secret
# App-level token with connections:write scope (Basic Information -> App-Level Tokens)
# Required for Socket Mode real-time listening; REST API works without it.
SLACK_APP_TOKEN=xapp-your-app-token

# REST API port for the Expo client integration
PORT=3001

# Supabase persistence — approved events are inserted into the same `events`
# table the mobile app and Discord bot use. Omit to keep events in memory only.
# Project Settings -> API: Project URL and service_role key (keep secret).
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# auth.users UUID of a dedicated bot user, used as organizer_id for imports
SUPABASE_ORGANIZER_ID=

# Optional: channel ID for a human-in-the-loop review flow. When set, parsed
# events are posted here with Approve/Reject buttons instead of being
# persisted automatically.
# SLACK_REVIEW_CHANNEL=C0123456789

# Optional: LLM tie-break for borderline duplicate detection via OpenRouter.
# Without a key, deduplication is heuristic-only (title similarity + time).
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=anthropic/claude-haiku-4.5
